# Copy to .env (never commit .env)
API_PORT=8100
OFFLINE_DEMO=false

# Stripe — TEST mode keys only (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=
# Exposed to the browser on purpose (pk_test_…); Vite reads it from this root .env
VITE_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8100/api/stripe/webhook` (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Aikido Local Scanner token (app.aikido.dev → Settings → Integrations → Local scan; shown once)
AIKIDO_API_KEY=
# Release gate threshold: low | medium | high | critical
AIKIDO_FAIL_ON=high
